{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx", // WAJIB INI
        "jsxImportSource": "react", // Tambahkan ini jika masih bandel

        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        },

        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowJs": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts"
    ]
}
